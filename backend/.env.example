# ===========================================
# SmartPharm Backend — Environment Variables
# ===========================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ===========================================

# Flask
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smartpharm
DB_USER=root
DB_PASSWORD=your-mysql-password
# Path to CA certificate for SSL connections (e.g., Aiven). Leave empty for local MySQL.
DB_SSL_CA=

# CORS (comma-separated origins for frontend dev)
CORS_ORIGINS=http://localhost:3000

# Optional single connection URL. For a local install without MySQL:
# DATABASE_URL=sqlite:///smartpharm.db
# Leave unset to use the DB_* MySQL settings above.
DATABASE_URL=

# Optional AI services; empty values enable local fallbacks.
PGVECTOR_URL=
PGVECTOR_SSL_CA=
GEMINI_API_KEY=
## Optional embedded web lookup for the stocking assistant
BRAVE_SEARCH_API_KEY=
TAVILY_API_KEY=
# SMARTPHARM_STOCKING_DIR=C:/path/to/stocking-data
